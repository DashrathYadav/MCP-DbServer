{
  "ConnectionStrings": {
    "DefaultConnection": "server=localhost;port=3306;database=your_database_name;user=your_username;password=your_password;SslMode=Preferred"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "MsDbServer": "Debug"
    }
  },
  "McpServer": {
    "Name": "MsDbServer",
    "Version": "2.0.0",
    "Description": "Modern MCP Database Server for MySQL introspection with 2025-06-18 specification compliance"
  },
  "DatabaseService": {
    "MaxPoolSize": 20,
    "MinPoolSize": 2,
    "ConnectionTimeoutSeconds": 30,
    "CommandTimeoutSeconds": 30,
    "EnablePerformanceMonitoring": true,
    "EnableQueryLogging": false
  }
}
